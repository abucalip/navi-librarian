# Navidrome connection
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# slskd connection
SLSKD_URL=
SLSKD_API_KEY=

# Optional discovery integrations
LASTFM_API_KEY=
# Radio scrobbling and love (off until switched on in the app): the shared secret and a session key.
LASTFM_SHARED_SECRET=
LASTFM_SESSION_KEY=
LISTENBRAINZ_USERNAME=

# Absolute paths on the Docker host; verify these on the deployment machine.
MUSIC_LIBRARY_HOST_PATH=/media/library/music
SLSKD_DOWNLOADS_HOST_PATH=/media/downloads/slskd/complete

# Optional host port for the web UI
WEB_PORT=8080
