<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WidgetKit only loads sandboxed extensions. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- The one folder the app writes the playing song to (NowPlayingShare.defaultFolder), read-only. No app group: the app is ad-hoc signed. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array><string>/Library/Application Support/Discair/Widget/</string></array>
</dict>
</plist>
