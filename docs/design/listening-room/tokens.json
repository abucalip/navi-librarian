{
  "name": "Listening Room",
  "version": 1,
  "note": "Single source for the web client's Listening Room design. _src/build.py writes tokens.css from this file; _src/check_contrast.py checks every pair listed under contrast. Px values are CSS px.",
  "color": {
    "bg":            {"value": "#101114", "use": "Page background behind the content column"},
    "rail":          {"value": "#0C0D10", "use": "Side menu background (desktop) and bottom tab bar (phone)"},
    "surface":       {"value": "#16181D", "use": "Cards and panels: Deep Dive, Paths, Genres, Radio, reason chips"},
    "surface-2":     {"value": "#1A1C21", "use": "Inputs, segmented controls, neutral buttons"},
    "raised":        {"value": "#23262D", "use": "Selected menu row, menus, popovers, hover fill"},
    "edge":          {"value": "#2A2D35", "use": "1px borders of panels and inputs"},
    "edge-strong":   {"value": "#666C78", "use": "Neutral button border, chip border, input border: anything that marks a control (3:1 on bg and surface)"},
    "text":          {"value": "#F2F1EE", "use": "Titles and body text"},
    "text-soft":     {"value": "#C5C8CE", "use": "Reason sentences, menu labels, secondary text that is still read"},
    "text-muted":    {"value": "#A7ABB3", "use": "Artist, year and meta lines; section descriptions"},
    "accent":        {"value": "#F5B544", "use": "The one primary action per view (Get on the lead pick), link text, focus ring, selected lens tab underline"},
    "accent-hover":  {"value": "#FFD27F", "use": "Hover and pressed state of accent"},
    "on-accent":     {"value": "#1A1300", "use": "Text and icons on accent"},
    "focus":         {"value": "#F5B544", "use": "2px focus ring, 2px offset"},
    "chip-selected": {"value": "#F2F1EE", "use": "Selected lens chip fill (text: bg)"},
    "progress-track":{"value": "#2A2D35", "use": "Download progress track"},
    "progress":      {"value": "#F2F1EE", "use": "Download progress fill"},
    "ok":            {"value": "#7FD69A", "use": "Success words only (Requested, Imported), always with text"},
    "danger":        {"value": "#FF8A7A", "use": "Error words and destructive actions only (Not this artist confirm), always with text"},
    "skeleton":      {"value": "#1F2228", "use": "Loading placeholders (no shimmer)"},
    "reason-fill":   {"value": "#1D2027", "use": "The reason panel behind every 'why this pick' block outside the lead pick (row cards, ranked rows, Deep Dive, grid-card reason strip)"},
    "reason-rule":   {"value": "#8A90A0", "use": "3px left rule of the reason panel; marks it as the pick's reason, never a control"},
    "scrim":         {"value": "rgba(0,0,0,0.55)", "use": "Behind sheets and the album modal"}
  },
  "hero": {
    "note": "The lead pick panel takes its colour from the cover. See LISTENING_ROOM_WEB.md section 4.3 for the sampling rule.",
    "fallback": "#2A1F33",
    "saturation_max": 0.5,
    "lightness_start": 0.2,
    "lightness_step": 0.01,
    "lightness_min": 0.06,
    "luminance_max": 0.04,
    "text": "#FFFFFF",
    "text-soft": "#E4E1E8",
    "eyebrow": "#E4E1E8",
    "button-fill": "rgba(255,255,255,0.10)",
    "button-edge": "rgba(255,255,255,0.44)",
    "aside-fill": "rgba(0,0,0,0.28)",
    "reason-fill": "rgba(0,0,0,0.32)",
    "reason-rule": "rgba(255,255,255,0.72)"
  },
  "font": {
    "display": {"family": "Instrument Sans", "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif", "weights": [600, 700], "files": ["fonts/instrument-sans-600.woff2", "fonts/instrument-sans-700.woff2"], "licence": "fonts/OFL-instrument-sans.txt"},
    "text":    {"family": "Inter", "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif", "weights": [400, 600], "files": ["static/fonts/inter-400.woff2", "static/fonts/inter-600.woff2"], "licence": "static/fonts/LICENSE-inter.txt"}
  },
  "type": {
    "note": "size/line-height in px; tracking in em. Only Inter 400/600 and Instrument Sans 600/700 are shipped: never ask for another weight.",
    "hero-title":    {"family": "display", "weight": 700, "size": 56, "line": 58, "tracking": -0.03, "phone": {"size": 36, "line": 40}},
    "page-title":    {"family": "display", "weight": 700, "size": 40, "line": 44, "tracking": -0.02, "phone": {"size": 30, "line": 34}},
    "section-title": {"family": "display", "weight": 600, "size": 22, "line": 28, "tracking": -0.01},
    "card-title":    {"family": "text", "weight": 600, "size": 14, "line": 20},
    "reason-hero":   {"family": "display", "weight": 600, "size": 24, "line": 32, "tracking": -0.01, "phone": {"size": 20, "line": 28}},
    "reason":        {"family": "display", "weight": 600, "size": 18, "line": 26, "tracking": -0.005, "phone": {"size": 16, "line": 24}},
    "reason-line":   {"family": "text", "weight": 600, "size": 14, "line": 20},
    "reason-label":  {"family": "text", "weight": 600, "size": 12, "line": 16, "tracking": 0.08, "case": "upper"},
    "body":          {"family": "text", "weight": 400, "size": 16, "line": 25},
    "meta":          {"family": "text", "weight": 400, "size": 13, "line": 18},
    "eyebrow":       {"family": "text", "weight": 600, "size": 12, "line": 16, "tracking": 0.08, "case": "upper"},
    "button":        {"family": "text", "weight": 600, "size": 14, "line": 16},
    "chip":          {"family": "text", "weight": 600, "size": 13, "line": 16},
    "nav":           {"family": "text", "weight": 600, "size": 14, "line": 16}
  },
  "space": [4, 8, 16, 24, 32],
  "space_note": "Every gap, padding and margin comes from this list. 48 and 64 appear only as sizes (cover, avatar), never as gaps.",
  "radius": {"cover": 4, "cover-lead": 8, "control": 8, "chip": 999, "panel": 16, "avatar": 999},
  "size": {
    "target": 44,
    "rail-width": 248,
    "content-max": 1360,
    "cover-lead": 360,
    "cover-grid-min": 176,
    "cover-row": 96,
    "cover-thumb": 56,
    "cover-mini": 40,
    "avatar-reason": 24,
    "avatar-artist": 44,
    "icon": 20,
    "icon-small": 16,
    "icon-stroke": 1.75,
    "tabbar-height": 64,
    "progress-height": 4
  },
  "breakpoints": {"phone": 0, "tablet": 720, "desktop": 1080, "wide": 1440, "note": "phone < 720: bottom tab bar, one column. 720-1079: rail collapses to 72px icons with labels in tooltips AND aria-label. >= 1080: full rail."},
  "shadow": {"cover-lead": "0 24px 48px rgba(0,0,0,0.45)", "menu": "0 8px 24px rgba(0,0,0,0.45)"},
  "motion": {
    "note": "No looping motion anywhere. Under prefers-reduced-motion every duration is 0.",
    "hero-tint": {"ms": 240, "ease": "cubic-bezier(0.2,0,0,1)", "what": "background-color of the hero panel when the lead pick changes"},
    "lens-swap": {"ms": 160, "ease": "linear", "what": "opacity of the Daily picks grid when a lens tab changes"},
    "press":     {"ms": 100, "ease": "linear", "what": "button background on press"},
    "sheet":     {"ms": 200, "ease": "cubic-bezier(0.2,0,0,1)", "what": "phone bottom sheet rise"}
  },
  "contrast": [
    ["text", "bg", 4.5], ["text-soft", "bg", 4.5], ["text-muted", "bg", 4.5],
    ["text", "surface", 4.5], ["text-soft", "surface", 4.5], ["text-muted", "surface", 4.5],
    ["text", "surface-2", 4.5], ["text-muted", "surface-2", 4.5],
    ["text", "raised", 4.5], ["text-soft", "raised", 4.5], ["text-muted", "raised", 4.5],
    ["text", "rail", 4.5], ["text-soft", "rail", 4.5], ["text-muted", "rail", 4.5],
    ["on-accent", "accent", 4.5], ["on-accent", "accent-hover", 4.5],
    ["accent", "bg", 4.5], ["accent", "surface", 4.5], ["accent", "rail", 4.5],
    ["bg", "chip-selected", 4.5],
    ["ok", "bg", 4.5], ["ok", "surface", 4.5], ["danger", "bg", 4.5], ["danger", "surface", 4.5], ["danger", "raised", 4.5],
    ["text", "reason-fill", 4.5], ["text-soft", "reason-fill", 4.5], ["text-muted", "reason-fill", 4.5], ["accent", "reason-fill", 4.5],
    ["edge-strong", "reason-fill", 3.0], ["reason-rule", "reason-fill", 3.0], ["reason-rule", "surface", 3.0], ["reason-rule", "bg", 3.0],
    ["text-soft", "surface-2", 4.5], ["ok", "raised", 4.5], ["edge-strong", "bg", 3.0], ["edge-strong", "surface", 3.0], ["focus", "bg", 3.0], ["progress", "progress-track", 3.0]
  ]
}
