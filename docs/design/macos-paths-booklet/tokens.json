  "motion": {
    "_note": "One-shot transitions only (DEVELOPMENT_WORKFLOW 'macOS client motion and CPU rules'). No TimelineView(.animation), no .repeatForever, no repeating symbol effects. Under Reduce Motion every duration below is 0.",
    "hover": {
      "duration": 0.12,
      "curve": "easeOut",
      "what": "card, edition row, extra, thumbnail ground"
    },
    "selectionScroll": {
      "duration": 0.12,
      "curve": "easeOut",
      "what": "ScrollViewReader.scrollTo the selected card (as today)"
    },
    "filter": {
      "duration": 0.15,
      "curve": "easeOut",
      "what": "cards that leave or join under the filter fade"
    },
    "spreadTurn": {
      "duration": 0.15,
      "curve": "easeOut",
      "what": "cross-fade between spreads; no page-curl"
    },
    "zoomReset": {
      "duration": 0.2,
      "curve": "easeOut",
      "what": "double-click back to Fit (as today)"
    },
    "pathCoverCycle": {
      "interval": 1.2,
      "what": "existing PathRowThumb alternate-cover cycle while hovering a cover; unchanged, one state step per 1.2 s, held under Reduce Motion"
    }
